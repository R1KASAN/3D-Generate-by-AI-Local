# Shared project defaults; copy to a local ignored .env file before running.
APP_ENV=development
GENERATION_ADAPTER=mock
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
COMFYUI_BASE_URL=http://127.0.0.1:8188
STORAGE_ROOT=./storage
DATABASE_PATH=./storage/jobs.sqlite3
MAX_UPLOAD_BYTES=10485760
RETENTION_HOURS=24
MIN_FREE_DISK_PERCENT=10
PUBLIC_DOMAIN=<owner-provided-at-public-deployment>

