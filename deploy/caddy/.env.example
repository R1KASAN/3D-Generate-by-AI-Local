# Copy to deploy/caddy/.env on the edge server only. Never commit the real
# file (it is git-ignored). Contains no secrets by design - PUBLIC_HOSTNAME
# and an email address are not credentials - but keep it out of version
# control anyway since it is host-specific.

# The approved public hostname. Must be a real DNS name pointing at
# 161.200.90.4 (T089). Do not put a bare IP here unless the owner has
# explicitly approved the IP-certificate fallback path documented in
# docs/operations/public-cutover.md - IP certs are short-lived (~160h) and
# require different renewal monitoring.
PUBLIC_HOSTNAME=

# Contact address for Let's Encrypt expiry/problem notices.
ACME_EMAIL=

# The GPU laptop's WireGuard tunnel address. This should almost always be
# exactly this value - the laptop's physical location and IP are irrelevant
# because it always presents as 10.10.0.2 over the tunnel.
UPSTREAM_ORIGIN=http://10.10.0.2:3000

# Optional override for the Caddy access log path.
CADDY_LOG_PATH=/var/log/caddy/local3d-access.log
