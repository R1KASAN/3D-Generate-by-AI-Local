# Local3D origin pass-through — Caddy (feature 003, outbound tunnel)
#
# Cloudflare Tunnel (cloudflared) is the only process that faces the
# provider. It dials outbound and forwards matched requests to this Caddy
# instance over loopback. Caddy itself has NO public listener: no :443, no
# TLS, no client certificate requirement. There is no provider-to-origin
# TLS hop for this process to authenticate anymore - cloudflared's outbound
# connection owns that job. See deploy/cloudflared/ and
# specs/003-outbound-tunnel-entry/contracts/origin-entry.md.
#
# Caddy's remaining job is a stateless, loopback-only streaming
# pass-through to the GPU laptop over the private WireGuard binding:
#   - stream request/response bodies, never buffer them (FR-014a) - the
#     origin holds no upload, artifact, or job state
#   - enforce an absurdity-guard body size limit during the stream
#   - strip X-Job-Token/Cookie/Authorization from the access log
#   - serve a maintenance page when the GPU laptop is unreachable
#   - never store job responses in a shared cache
#
# Required environment (see .env.example):
#   UPSTREAM_ORIGIN   - http://10.10.0.2:3000
#   CADDY_LOG_PATH    - optional override for the access-log path
#
# Policy invariants:
#   - no site-wide login; job resources use per-job capability tokens
#   - loopback-only listener; cloudflared is the only reachable caller
#   - request and response bodies are never buffered to disk
{
	admin off
}

http://127.0.0.1:8443 {
	# Security headers. The visitor's TLS terminates at the provider edge;
	# these still apply to what this process itself returns.
	header {
		Strict-Transport-Security "max-age=31536000"
		Cache-Control "no-store"
		X-Request-ID {http.request.uuid}
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Origin-generated correlation identifier: overwrite arbitrary client input.
	# Only a validated resource ID is retained; raw URL/query/headers are omitted.
	log_append <request_id {http.request.uuid}
	@job path_regexp job ^/api/v1/jobs/([a-f0-9-]{36})(/(model|download))?$
	log_append @job <job_id {re.job.1}

	# Absurdity guard only, enforced during the stream (not after buffering
	# the full body). The application enforces the authoritative 10 MiB
	# upload policy.
	request_body {
		max_size 12MB
	}

	# Streams by default - no buffer_requests / buffer_responses directive
	# is set here, and none may be added without violating FR-014a.
	route {
		# Check engine availability before relaying each request, using a GET
		# clone so the upload body is not consumed. This is a health check only;
		# it adds no login, credentials, or authentication dependency.
		reverse_proxy {$UPSTREAM_ORIGIN} {
			method GET
			rewrite /api/v1/health/engine?
			header_up X-Request-ID {http.request.uuid}
			transport http {
				dial_timeout 1s
				response_header_timeout 2s
			}
			@ready status 2xx
			handle_response @ready {
				# Continue to the streaming handler with the original request.
				vars origin_ready true
			}
			@unavailable status 3xx 4xx 5xx
			handle_response @unavailable {
				root * /srv/caddy/maintenance
				rewrite * /maintenance.html
				header Retry-After "30"
				file_server {
					status 503
				}
			}
		}
		reverse_proxy {$UPSTREAM_ORIGIN} {
			header_up X-Request-ID {http.request.uuid}
			fail_duration 10s
			health_uri /
			health_interval 15s
			health_timeout 5s

			transport http {
				dial_timeout 2s
				response_header_timeout 2s
			}

			# Job data and generated artifacts must never be stored in a
			# shared cache (FR-030).
			header_down Cache-Control "no-store"
		}
	}

	# Expected mobility state: the laptop may be offline while the origin
	# and provider entry remain healthy and serve this purpose-written
	# notice, per FR-025 (no internal address, port, or stack detail).
	handle_errors {
		header {
			Cache-Control "no-store"
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			X-Request-ID {http.request.uuid}
			-Server
		}
		@upstreamDown expression {http.error.status_code} in [502, 503, 504]
		handle @upstreamDown {
			root * /srv/caddy/maintenance
			rewrite * /maintenance.html
			file_server
			header Retry-After "30"
		}
		handle {
			respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
		}
	}

	# Explicitly remove arbitrary credential headers from access-log output.
	log {
		output file {$CADDY_LOG_PATH:-/var/log/caddy/local3d-access.log} {
			roll_size 10MB
			roll_keep 7
		}
		format filter {
			wrap json
			fields {
				request>headers>X-Job-Token delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers delete
				request>uri delete
				request>host delete
				request>remote_ip delete
				request>client_ip delete
				resp_headers delete
			}
		}
	}
}
