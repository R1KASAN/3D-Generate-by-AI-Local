{
	admin off
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				request>headers>X-Job-Token delete
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>uri delete
				request>remote_ip delete
				request>client_ip delete
				resp_headers delete
			}
		}
	}
}

:8080 {
	bind 127.0.0.1

	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	request_body {
		max_size 12MB
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy {$API_UPSTREAM} {
			header_up X-Request-ID {http.request.uuid}
			header_down Cache-Control "no-store"
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM} {
			header_up X-Request-ID {http.request.uuid}
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
	}

	handle_errors {
		root * {$CADDY_MAINTENANCE_ROOT}
		rewrite * /maintenance.html
		file_server
	}

	log {
		output file {$CADDY_LOG_PATH}
		format filter {
			wrap json
			fields {
				request>headers delete
				request>headers>X-Job-Token delete
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>uri delete
				request>remote_ip delete
				request>client_ip delete
				resp_headers delete
			}
		}
	}
}
