<?xml version="1.0" encoding="UTF-8"?>
<service>
  <id>Local3D-Caddy</id>
  <name>Local 3D Caddy</name>
  <description>Loopback-only reverse proxy for the single-node AI test service.</description>
  <executable>%BASE%\caddy.exe</executable>
  <arguments>run --config "%BASE%\..\..\..\deploy\caddy\Caddyfile" --adapter caddyfile</arguments>
  <workingdirectory>%BASE%\..\..\..\</workingdirectory>
  <env name="CADDY_LISTEN_ADDRESS" value="127.0.0.1:8080" />
  <env name="WEB_UPSTREAM" value="http://127.0.0.1:3000" />
  <env name="API_UPSTREAM" value="http://127.0.0.1:8000" />
  <env name="CADDY_MAINTENANCE_ROOT" value="%BASE%\..\..\..\deploy\caddy\maintenance" />
  <env name="CADDY_LOG_PATH" value="%BASE%\..\..\..\logs\caddy-access.log" />
  <startmode>Automatic</startmode>
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
  <depend>Local3D-Web</depend>
  <log mode="roll-by-size-time">
    <sizeThreshold>10485760</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <keepFiles>7</keepFiles>
  </log>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
</service>
