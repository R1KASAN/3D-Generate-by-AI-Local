<?xml version="1.0" encoding="UTF-8"?>
<service>
  <id>Local3D-Web</id>
  <name>Local 3D Web</name>
  <description>Next.js frontend for local 3D generation, bound to the WireGuard tunnel address (10.10.0.2) so the public edge at 161.200.90.4 can reach it while ports 8000/8188 stay loopback-only. See docs/operations/tunnel-setup.md.</description>
  <executable>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</executable>
  <arguments>-NoLogo -NonInteractive -NoProfile -ExecutionPolicy Bypass -File "%BASE%\..\..\..\scripts\windows\start_web_service.ps1" -TunnelAddress 10.10.0.2 -EdgeTunnelAddress 10.10.0.1 -Port 3000</arguments>
  <workingdirectory>%BASE%\..\..\..\apps\web</workingdirectory>
  <startmode>Automatic</startmode>
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
  <!-- Order matters: the WireGuard tunnel must be up and the tunnel address
       assigned before Next.js can bind to it. This <depend> reduces the
       startup race but does not eliminate it (a dependency service can
       report "started" before the interface address actually exists), so
       start_web_service.ps1 also polls for the address and a live
       handshake before invoking `next start`. Replace WireGuardTunnel$upstream
       with the actual tunnel service name if it differs on the deployed
       machine (WireGuard for Windows names it WireGuardTunnel$<tunnel-name>). -->
  <depend>WireGuardTunnel$upstream</depend>
  <depend>Local3D-API</depend>
  <log mode="roll-by-size-time">
    <sizeThreshold>10485760</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <keepFiles>7</keepFiles>
  </log>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
</service>
