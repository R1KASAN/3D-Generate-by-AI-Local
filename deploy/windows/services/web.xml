<?xml version="1.0" encoding="UTF-8"?>
<service>
  <id>Local3D-Web</id>
  <name>Local 3D Web</name>
  <description>Private loopback Next.js frontend for local 3D generation.</description>
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>node_modules\next\dist\bin\next start --hostname 127.0.0.1 --port 3000</arguments>
  <workingdirectory>%BASE%\..\..\..\apps\web</workingdirectory>
  <startmode>Automatic</startmode>
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
  <depend>Local3D-API</depend>
  <log mode="roll-by-size-time">
    <sizeThreshold>10485760</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <keepFiles>7</keepFiles>
  </log>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
</service>
