APP_ENV=development
GENERATION_ADAPTER=mock
API_HOST=127.0.0.1
API_PORT=8000
COMFYUI_BASE_URL=http://127.0.0.1:8188
STORAGE_ROOT=./storage
DATABASE_PATH=./storage/jobs.sqlite3
MAX_UPLOAD_BYTES=10485760
RETENTION_HOURS=24
MIN_FREE_DISK_PERCENT=10
WORKFLOW_MANIFEST_PATH=./workflows/hunyuan3d/workflow-manifest.json

# Global durable admission bounds; no client IP or new identity is stored.
MAX_PENDING_JOBS=20
MAX_SUBMISSIONS_PER_MINUTE=30
MAX_IDENTICAL_PER_MINUTE=5
